<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PersonalBlog</title>
    <!--Bootstrap CSS-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
   <!--hight light-->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css">
    <style>
            /* 文章内容区间距压缩 */
            #post-content p,
            #post-content pre,
            #post-content ul,
            #post-content ol {
                margin-bottom: 0.5rem; /* Bootstrap 默认是 1rem，压缩一半 */
            }

            #post-content pre {
                padding: 0.75rem;
                background-color: #f6f8fa; /* GitHub 风格的代码背景色 */
                border-radius: 6px;
            }

            #post-content li {
                margin-bottom: 0.25rem;
            }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-page="/Posts/Index">📝 PersonalBlog</a>
            <a class="btn btn-outline-light btn-sm" asp-page="/Admin/Index">Administrator Login</a>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- highlight.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>