@page
@model PersonalBlog.Pages.Admin.IndexModel

<!--Create Posts-->
<h1>Posts Manage</h1>
<a asp-page="./Create">Write a new Post</a>
<br/>
<br/>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>State</th>
            <th>CreateAt</th>
            <th>Modify</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var post in Model.Posts){
            <tr>
                <td>@post.Title</td>
                <td>@post.IsPublished</td>
                <td>@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@post.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@post.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!--Login out-->
<form method="post" asp-page="./Logout">
    <button type="submit">Logout</button>
</form>
<a asp-page="/Posts/index">Back to Posts Index</a>
