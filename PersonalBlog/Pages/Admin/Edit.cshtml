@page "{id:int}"
@model PersonalBlog.Pages.Admin.EditModel
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css" />
}
<h1>Edit a Post</h1>
<form method="post">
    <input type="hidden" asp-for="Post.Id" />
    <input type="hidden" asp-for="Post.Slug" />
    <input type="hidden" asp-for="Post.CreatedAt" />
    <div>
        <label asp-for="Post.Title">Title</label>
        <input asp-for="Post.Title" />
        <span asp-validation-for="Post.Title"></span>
    </div>
    <div>
        <label asp-for="Post.Content">Content</label>
        <textarea asp-for="Post.Content" id="editor" rows="30" class="form-control font-monospace"></textarea>
    </div>
    <div>
        <label asp-for="Post.IsPublished">
            <input asp-for="Post.IsPublished" type="checkbox" />
            Publish
        </label>
    </div>
    <button type="submit">Submit</button>
    <a asp-page="./Index">Cancel</a>
</form>

<!--Delete post-->
<form method="post" asp-page-handler="Delete" asp-route-Id="@Model.Post.Id"
onsubmit="return confirm('Are you sure delete the post')">
<button type="submit" style="color:red">Delete Post</button>
</form>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js"></script>
    <script>
        var easyMDE = new EasyMDE({
            element: document.getElementById("editor"),
            spellChecker: false,          // 关闭英文拼写检查
            autosave: {
                enabled: true,
                uniqueId: "post-editor-@Model.Post.Id",  // 自动保存到浏览器本地
                delay: 3000,              // 每3秒自动保存一次
            },
            toolbar: [
                "bold", "italic", "heading", "|",
                "quote", "code", "unordered-list", "ordered-list", "|",
                "link", "image", "|",
                "preview", "side-by-side", "fullscreen", "|",
                "guide"
            ]
        });
    </script>
}