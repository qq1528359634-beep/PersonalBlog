@page "{slug}"
@model PersonalBlog.Pages.Posts.DetailModel
<!--Automatically load this script when the page loads-->
<div class="row justify-content-center">
    <div class="col-lg-8">

        <a asp-page="/Posts/Index" class="btn btn-outline-secondary btn-sm mb-4">← Back to Home</a>

        <article class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h1 class="card-title mb-2">@Model.Post.Title</h1>
                <p class="text-muted small mb-4">
                    🗓️ <time>@Model.Post.CreatedAt.ToString("yyyy-MM-dd")</time>
                </p>
                <div id="post-content" class="fs-5 lh-lg">
                    @Html.Raw(Model.Post.Content)
                </div>
            </div>
        </article>

        <section id="comment-section" class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">💬 Comments</h2>

                <div id="comment-list" class="mb-4">
                    <p class="text-muted">Loading comments...</p>
                </div>

                <div id="comment-form" class="border-top pt-3">
                    <div class="mb-2">
                        <input type="text" id="comment-authorName" class="form-control" placeholder="Your name" />
                    </div>
                    <div class="mb-2">
                        <textarea id="comment-content" class="form-control" rows="3" placeholder="Write your comment..."></textarea>
                    </div>
                    <button onclick="submitComment('@Model.Post.Slug')" class="btn btn-primary">Submit Comment</button>
                </div>
            </div>
        </section>

    </div>
</div>
@section Scripts {
    <script src="~/js/comments.js"></script>
    <script>
        loadComments('@Model.Post.Slug')
    </script>
}
