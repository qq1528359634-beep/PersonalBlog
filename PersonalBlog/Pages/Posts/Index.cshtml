@page 
@model PersonalBlog.Pages.Posts.IndexModel
<a asp-page="/Admin/Login">Administrator Login</a>
<a asp-page="/Admin/index">AdminPage</a>

    @if (!Model.Posts.Any())
    {
        <p>No articles available</p>
    }
    else
{
    @foreach (var post in Model.Posts)
    {
       <article>
           <h2><a asp-page="./Detail" asp-route-slug="@post.Slug">
               @post.Title
           </a></h2>
           <time>@post.CreatedAt.ToString("yyyy-MM-dd")</time>
       </article>


<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Posts</h1>
          
        </div>

        @if (!Model.Posts.Any())
        {
            <div class="alert alert-secondary text-center">
                No articles available
            </div>
        }
        else
        {
            @foreach (var post in Model.Posts)
            {
                <div class="card mb-3 shadow-sm border-0">
                    <div class="card-body">
                        <h2 class="card-title h4 mb-2">
                            <a asp-page="./Detail" asp-route-slug="@post.Slug" class="text-decoration-none text-dark">
                                @post.Title
                            </a>
                        </h2>
                        <p class="card-text text-muted small mb-0">
                            🗓️ @post.CreatedAt.ToString("yyyy-MM-dd")
                        </p>
                    </div>
                </div>
            }
        }

}

